# Bootstrap environment only (P7.5). Everything governing runtime behaviour — model, concurrency,
# cost ceiling, thresholds — lives in the app_config table, not here.
NODE_ENV=development
HOST=127.0.0.1
PORT=3101
LOG_LEVEL=info

# Required. Crucible has no in-memory mode.
DATABASE_URL=postgresql://localhost:5432/crucible

# Required. Minimum 32 characters. Never commit a real value (P8.3).
JWT_SECRET=change-me-to-at-least-thirty-two-characters

# Optional. Without it the gateway boots and model-backed calls fail with a named error,
# so scanning, probing and review stay usable while a key is provisioned.
# ANTHROPIC_API_KEY=

# Optional. Defaults to the OS temp directory.
# WORKSPACE_ROOT=/tmp/crucible

# How this machine reaches a model. Set EITHER of these:
#   ANTHROPIC_API_KEY  the HTTP path — preferred, faster, cost computed from the price table
#   LLM_CLI_BINARY     a locally installed CLI that reaches the same models, for a machine that
#                      has the tool signed in but no key provisioned. Same gateway, same retry
#                      classification, same citation checking; only the call log records which.
# With both set the HTTP path wins, so provisioning a key changes nothing else.
# LLM_CLI_BINARY=claude

# Optional. Lets an ADMIN reveal a team's current submission code, audited (ADR 0005). Without
# it codes are shown once at issue and never recoverable, which is the safer default. Generate
# with: openssl rand -base64 32
# TOKEN_REVEAL_KEY=

# How this machine sends email. Without these, every message is COMPOSED and nothing is
# transmitted: the delivery panel says so, and an organiser can download the messages and send
# them by hand. Registration links, submission codes, pre-flight results, reminders and coach
# sheets all go this way.
#   MAIL_PROVIDER=record   the default. Composes, transmits nothing.
#   MAIL_PROVIDER=resend   transmits over HTTP. Then MAIL_API_KEY and MAIL_FROM are both
#                          REQUIRED and the API refuses to boot without them, naming the missing one.
#   MAIL_PROVIDER=smtp     transmits through a relay you have a mailbox on. Needs no domain of
#                          your own: authenticating as a mailbox authorises sending as it, so mail
#                          leaves with that provider's reputation. SMTP_HOST, SMTP_USER,
#                          SMTP_PASSWORD and MAIL_FROM are all REQUIRED, and MAIL_FROM must match
#                          SMTP_USER or the relay will refuse to send as it.
# MAIL_FROM must be an address on a domain you have verified with the provider, or everything is
# accepted by the API and silently dropped before it reaches anybody.
# MAIL_PROVIDER=record
# MAIL_API_KEY=
# MAIL_FROM=
#
# For MAIL_PROVIDER=smtp. Gmail: host smtp.gmail.com, port 587, and an APP PASSWORD generated at
# myaccount.google.com/apppasswords — the account password will not work and repeated attempts
# with it can lock the mailbox. Consumer Gmail allows roughly 500 recipients a day.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# SMTP_SECURE=false

# Optional. Discord delivery (E49): with both set, a team contact who gave a Discord username at
# registration gets their code and pre-flight results by DM, with email as the recorded fallback.
# The bot must be a member of the event server and needs only "Send Messages" — no privileged
# intents; the username lookup uses the REST member search. Generate the token in the Discord
# developer portal; the guild id is the server's id (Developer Mode → right-click the server).
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
