{
  "name": "crucible-aws",
  "version": "1.0.0",
  "private": true,
  "description": "Crucible on AWS: one host, RDS, one secret. CDK (TypeScript); `cdk synth` emits the CloudFormation template.",
  "type": "module",
  "scripts": {
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "aws-cdk": "^2.170.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
