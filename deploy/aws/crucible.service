# systemd unit so the stack comes back after a reboot without anyone logging in.
# Install: sudo cp crucible.service /etc/systemd/system/ && sudo systemctl enable crucible
[Unit]
Description=Crucible (docker compose)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/crucible
Environment=SITE_ADDRESS=
EnvironmentFile=-/opt/crucible/.deploy.env
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
