    "@crucible/scoring": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.0",
    "mammoth": "^1.12.3",
    "nodemailer": "^10.0.13",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10"
