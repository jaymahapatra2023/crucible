{
  "name": "@crucible/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Crucible API — Fastify. Endpoints, orchestration, gateway, persistence.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
