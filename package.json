{
  "name": "crucible",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @crucible/api build && pnpm --filter @crucible/web build",
    "typecheck": "pnpm -r typecheck",
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @crucible/api dev\" \"pnpm --filter @crucible/web dev\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:api": "vitest run --project api",
    "test:web": "vitest run --project web",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx apps/api/src/db/cli/migrate.ts",
    "user:create": "tsx apps/api/src/db/cli/createUser.ts",
    "db:reset": "tsx apps/api/src/db/cli/reset.ts",
    "db:seed": "tsx apps/api/src/db/cli/seed.ts",
    "db:seed:cohort": "tsx apps/api/src/db/cli/seedCohort.ts",
    "db:seed:discovery": "tsx apps/api/src/db/cli/seedDiscovery.ts",
    "calibration": "tsx apps/api/src/cli/calibration.ts",
    "guard:naming": "node scripts/guard-naming.mjs",
    "guard:llm": "node scripts/guard-llm.mjs",
    "guard:filesize": "node scripts/guard-filesize.mjs",
    "guard": "pnpm guard:naming && pnpm guard:llm && pnpm guard:filesize",
    "verify": "pnpm guard && pnpm lint && pnpm typecheck && pnpm test",
    "test:all": "pnpm test && pnpm test:security && pnpm test:e2e",
    "test:security": "vitest run --project security"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "pg": "^8.13.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
