{
  "name": "@crucible/scanner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone repository scanner. No database, no auth, no platform coupling (E04).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run"
  }
}
